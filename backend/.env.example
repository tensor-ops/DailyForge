# ============================================================
# DAILY FORGE — BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

NODE_ENV=development
PORT=5000
APP_NAME=DailyForge
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai-habit-tracker

# JWT Security
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# OTP Security & Rate Limiting
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_PEPPER_SECRET=daily_forge_otp_secret_pepper_2026

# Email Provider Configuration (gmail | console)
# Set to 'gmail' in production with Google Cloud OAuth2 credentials
EMAIL_PROVIDER=console
GMAIL_SENDER_EMAIL=dailyforge.app@gmail.com
EMAIL_SENDER_NAME=DailyForge Security

# Google Cloud OAuth2 Credentials for Gmail API (https://www.googleapis.com/auth/gmail.send)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# AI Intelligence
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20
